# Kopieren nach flur.env und neben docker compose legen.
# Nichts davon ins Git committen.

TZ=Europe/Berlin

# WebUntis. Server z. B. mese.webuntis.com oder https://mese.webuntis.com
FLUR_WEBUNTIS_SERVER=
FLUR_WEBUNTIS_SCHOOL=
FLUR_WEBUNTIS_USER=
FLUR_WEBUNTIS_PASSWORD=
# student, class oder teacher
FLUR_WEBUNTIS_WHO=student
# Nur bei class oder teacher: Klassenname oder Kürzel
FLUR_WEBUNTIS_NAME=

# Weg. Leer lassen zeigt die Beispielstrecke Köln Süd → Köln Hbf.
FLUR_HOME=
FLUR_STATION=
FLUR_SCHOOL_STOP=
# bus, car, bike oder walk
FLUR_MODE=bike
